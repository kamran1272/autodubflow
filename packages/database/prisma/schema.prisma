generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AutomationStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
}

enum SourceVideoStatus {
  QUEUED
  INGESTED
  ANALYZING
  DUBBING
  EDITING
  CAPTIONING
  RENDERING
  QC
  READY
  PUBLISHED
  FAILED
}

enum WorkflowEventType {
  SOURCE_EVENT
  ELIGIBILITY_CHECKED
  MEDIA_INGESTION_REQUESTED
  MEDIA_INGESTED
  MEDIA_VALIDATED
  DUBBING_COMPLETED
  VIDEO_ANALYSIS_COMPLETED
  SMART_REFRAME_COMPLETED
  EXISTING_CAPTION_DETECTED
  CAPTION_MASK_COMPLETED
  TRANSITIONS_COMPLETED
  TARGET_CAPTIONS_COMPLETED
  RENDER_COMPLETED
  QUALITY_CONTROL_PASSED
  METADATA_COMPLETED
  READY_BUFFERED
  SCHEDULED
  PUBLISH_REQUESTED
  PUBLISHED
  VERIFIED
  WORKFLOW_FAILED
}

enum WorkflowStage {
  ELIGIBILITY_CHECK
  MEDIA_INGESTION
  MEDIA_VALIDATION
  DUBBING
  VIDEO_ANALYSIS
  SMART_REFRAME
  EXISTING_CAPTION_DETECTION
  CAPTION_MASK
  TRANSITIONS
  TARGET_CAPTION_GENERATION
  RENDER
  QUALITY_CONTROL
  METADATA
  READY_BUFFER
  SCHEDULING
  PUBLISH
  VERIFY
}

enum StageExecutionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  RETRYABLE_FAILURE
  TERMINAL_FAILURE
  CANCELLED
  SKIPPED
}

enum ProjectStatus {
  DRAFT
  PROCESSING
  REVIEW
  READY
  EXPORTED
  FAILED
}

enum MediaAssetKind {
  SOURCE
  DUBBED
  INTERMEDIATE
  FINAL
  CAPTIONS
  PREVIEW
  THUMBNAIL
  AUDIO
}

enum PublishJobStatus {
  PENDING
  RESERVED
  UPLOADING
  SCHEDULED
  PUBLISHED
  VERIFIED
  RETRYABLE_FAILURE
  TERMINAL_FAILURE
  CANCELLED
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  emailVerified Boolean   @default(false)
  name          String?
  image         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  accounts      Account[]
  sessions      Session[]
  automations   Automation[]
  sourceVideos  SourceVideo[]
  rightsGrants  AutomationRightsGrant[]
  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  projects       Project[]
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                String    @id @default(cuid())
  accountId         String
  providerId        String
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken       String?
  refreshToken      String?
  idToken           String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope            String?
  password         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([identifier, value])
  @@map("verification")
}

model SourceChannel {
  id        String       @id @default(cuid())
  name      String
  provider  String
  type      String       @default("youtube")
  url       String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  automations Automation[] @relation("AutomationSourceChannel")
  sourceVideos SourceVideo[]
}

model DestinationChannel {
  id        String       @id @default(cuid())
  name      String
  provider  String
  type      String       @default("youtube")
  url       String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  automations Automation[] @relation("AutomationDestinationChannel")
}

model Schedule {
  id            String       @id @default(cuid())
  cronExpression String
  timezone      String       @default("UTC")
  enabled       Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  automations   Automation[]
  slots         ScheduleSlot[]
}

model ScheduleSlot {
  id          String    @id @default(cuid())
  scheduleId  String
  schedule    Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  weekday     Int?
  localTime   String
  timezone    String
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([scheduleId, enabled])
}

model Template {
  id          String       @id @default(cuid())
  name        String
  description String?
  content     String       @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  automations Automation[]
}

model ProcessingConfig {
  id              String         @id @default(cuid())
  name            String?
  sourceLanguage  String
  targetLanguage  String
  voiceProfile    String?
  modelSettings   Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  automations     Automation[]
  sourceVideos    SourceVideo[]
}

model Automation {
  id                  String             @id @default(cuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  status              AutomationStatus   @default(DRAFT)
  sourceChannelId     String?
  sourceChannel       SourceChannel?     @relation("AutomationSourceChannel", fields: [sourceChannelId], references: [id])
  destinationChannelId String?
  destinationChannel  DestinationChannel? @relation("AutomationDestinationChannel", fields: [destinationChannelId], references: [id])
  scheduleId          String?
  schedule            Schedule?          @relation(fields: [scheduleId], references: [id])
  templateId          String?
  template            Template?          @relation(fields: [templateId], references: [id])
  processingConfigId  String?
  processingConfig    ProcessingConfig?  @relation(fields: [processingConfigId], references: [id])
  videos              SourceVideo[]
  rightsGrants        AutomationRightsGrant[]
  publishJobs         PublishJob[]
  workspaceId         String?
  workspace           Workspace?          @relation(fields: [workspaceId], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([userId])
  @@index([status])
  @@index([workspaceId, status])
}

model SourceVideo {
  id                 String            @id @default(cuid())
  automationId       String
  automation         Automation        @relation(fields: [automationId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?             @relation(fields: [userId], references: [id])
  sourceChannelId    String?
  sourceChannel      SourceChannel?    @relation(fields: [sourceChannelId], references: [id])
  title              String
  externalUrl        String?
  status             SourceVideoStatus @default(QUEUED)
  processingConfigId String?
  processingConfig   ProcessingConfig? @relation(fields: [processingConfigId], references: [id])
  media              Media?
  dubbing            Dubbing?
  analysis           Analysis?
  editing            Editing?
  captions           Captions?
  render             Render?
  qualityControl     QC?
  publish            Publish?
  readyBuffer        ReadyBufferItem?
  externalIdentities SourceVideoExternalIdentity[]
  workflowEvents     WorkflowEvent[]
  stageExecutions    StageExecution[]
  projects           Project[]
  assets             MediaAsset[]
  publishJobs        PublishJob[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([automationId])
  @@index([status])
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  ownerId     String
  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  automations Automation[]
  projects    Project[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([ownerId])
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("member")
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Project {
  id            String       @id @default(cuid())
  workspaceId   String
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceVideoId String?
  sourceVideo   SourceVideo? @relation(fields: [sourceVideoId], references: [id], onDelete: SetNull)
  name          String
  status        ProjectStatus @default(DRAFT)
  editorState   Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  assets        MediaAsset[]
  transcript    Transcript?
  translations  Translation[]
  audioAssets   AudioAsset[]
  versions      ProjectVersion[]
  exports       Export[]

  @@index([workspaceId, status])
  @@index([userId])
  @@index([sourceVideoId])
}

model MediaAsset {
  id            String          @id @default(cuid())
  projectId     String?
  project       Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceVideoId String?
  sourceVideo   SourceVideo?    @relation(fields: [sourceVideoId], references: [id], onDelete: SetNull)
  kind          MediaAssetKind
  storageKey    String
  mimeType      String
  sizeBytes     BigInt?
  checksum      String?
  metadata      Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  audioAssets   AudioAsset[]
  exports       Export[]

  @@index([projectId, kind])
  @@index([sourceVideoId, kind])
}

model Transcript {
  id          String              @id @default(cuid())
  projectId   String              @unique
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  language    String?
  provider    String?
  segments   TranscriptSegment[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model TranscriptSegment {
  id           String     @id @default(cuid())
  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  startMs      Int
  endMs        Int
  speaker      String?
  text         String     @db.Text
  confidence   Float?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([transcriptId, startMs])
}

model Translation {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceLanguage String
  targetLanguage String
  style         String    @default("natural")
  content       Json
  provider      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([projectId, targetLanguage, style])
  @@index([projectId, targetLanguage])
}

model AudioAsset {
  id            String      @id @default(cuid())
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaAssetId  String?
  mediaAsset    MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  language      String?
  voiceId       String?
  kind          String
  settings      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([projectId, kind])
}

model Voice {
  id          String   @id @default(cuid())
  provider    String
  providerId  String
  name        String
  language    String
  accent      String?
  style       String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([provider, providerId])
  @@index([language])
}

model ProjectVersion {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version     Int
  state       Json
  createdAt   DateTime @default(now())

  @@unique([projectId, version])
}

model Export {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaAssetId String?
  mediaAsset  MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  preset      String
  status      String      @default("pending")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([projectId, status])
}

model PublishJob {
  id             String          @id @default(cuid())
  automationId   String
  sourceVideoId  String
  destinationId  String?
  provider       String
  status         PublishJobStatus @default(PENDING)
  idempotencyKey String          @unique
  providerJobId   String?
  providerVideoId String?
  scheduledAt     DateTime?
  publishedAt     DateTime?
  verifiedAt      DateTime?
  errorCode       String?
  errorMessage    String?         @db.Text
  automation     Automation      @relation(fields: [automationId], references: [id], onDelete: Cascade)
  sourceVideo    SourceVideo     @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([automationId, sourceVideoId])
  @@index([status, scheduledAt])
}

model AutomationRightsGrant {
  id              String     @id @default(cuid())
  automationId    String
  automation      Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String
  sourceReference String
  consentVersion  String
  confirmedAt     DateTime   @default(now())
  revokedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([automationId, revokedAt])
  @@index([userId, provider])
}

model SourceVideoExternalIdentity {
  id           String      @id @default(cuid())
  sourceVideoId String
  sourceVideo  SourceVideo @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  provider     String
  externalId   String
  canonicalUrl String?
  publishedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([provider, externalId])
  @@index([sourceVideoId])
}

model WorkflowEvent {
  id             String            @id @default(cuid())
  sourceVideoId  String
  sourceVideo    SourceVideo       @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  type           WorkflowEventType
  stage          WorkflowStage?
  idempotencyKey String            @unique
  correlationId  String?
  payload        Json
  occurredAt     DateTime
  appliedAt      DateTime?
  createdAt      DateTime          @default(now())

  @@index([sourceVideoId, occurredAt])
  @@index([type, appliedAt])
}

model StageExecution {
  id             String               @id @default(cuid())
  sourceVideoId  String
  sourceVideo    SourceVideo          @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  stage          WorkflowStage
  status         StageExecutionStatus @default(PENDING)
  attempt        Int                  @default(0)
  idempotencyKey String               @unique
  workerId       String?
  leaseExpiresAt DateTime?
  heartbeatAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  nextAttemptAt  DateTime?
  errorCode      String?
  errorMessage   String?              @db.Text
  input          Json?
  output         Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([sourceVideoId, stage, attempt])
  @@index([status, nextAttemptAt])
  @@index([sourceVideoId, stage])
}

model Media {
  id            String      @id @default(cuid())
  sourceVideoId String      @unique
  sourceVideo   SourceVideo @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  fileKey       String?
  format        String?
  durationSeconds Int?
  checksum      String?
  status        String      @default("pending")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Dubbing {
  id            String      @id @default(cuid())
  sourceVideoId String      @unique
  sourceVideo   SourceVideo @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  provider      String?
  voiceProfile  String?
  status        String      @default("pending")
  outputUrl     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Analysis {
  id            String      @id @default(cuid())
  sourceVideoId String      @unique
  sourceVideo   SourceVideo @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  transcript    String?     @db.Text
  summary       String?     @db.Text
  language      String?
  sentiment     Float?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Editing {
  id            String      @id @default(cuid())
  sourceVideoId String      @unique
  sourceVideo   SourceVideo @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  editor        String?
  status        String      @default("pending")
  notes         String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Captions {
  id            String      @id @default(cuid())
  sourceVideoId String      @unique
  sourceVideo   SourceVideo @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  format        String?
  status        String      @default("pending")
  fileKey       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Render {
  id            String      @id @default(cuid())
  sourceVideoId String      @unique
  sourceVideo   SourceVideo @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  status        String      @default("pending")
  outputUrl     String?
  format        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model QC {
  id            String      @id @default(cuid())
  sourceVideoId String      @unique
  sourceVideo   SourceVideo @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  status        String      @default("pending")
  issues        String?     @db.Text
  passed        Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Publish {
  id            String      @id @default(cuid())
  sourceVideoId String      @unique
  sourceVideo   SourceVideo @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  status        String      @default("pending")
  publishedUrl  String?
  channelName   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model ReadyBufferItem {
  id            String      @id @default(cuid())
  sourceVideoId String      @unique
  sourceVideo   SourceVideo @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  status        String      @default("ready")
  scheduledAt   DateTime?
  publishedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, scheduledAt])
}
