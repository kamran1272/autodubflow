# ---------------------------------------------------------------------------
# DubFlow environment configuration
# Copy to `.env` and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_ENV=development
PORT=4000
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
LOG_LEVEL=info

# --- Database --------------------------------------------------------------
# Local development and tests use SQLite through prisma/schema.sqlite.prisma:
#   DATABASE_URL="file:./dev.db"      (resolved to prisma/dev.db)
# Production uses PostgreSQL through prisma/schema.prisma:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dubflow?schema=public
DATABASE_URL="file:./dev.db"

# --- Queue / workers -------------------------------------------------------
# QUEUE_DRIVER=auto       -> BullMQ when REDIS_URL is reachable, otherwise the
#                            built-in database-backed worker (no Redis needed).
# QUEUE_DRIVER=in-process -> always use the database-backed worker.
# QUEUE_DRIVER=bullmq     -> require Redis + BullMQ.
QUEUE_DRIVER=auto
REDIS_URL=redis://localhost:6379
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=750

# --- Authentication / security --------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret-value
SESSION_COOKIE_NAME=dubflow_session
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute

# --- Storage ---------------------------------------------------------------
# local -> filesystem under STORAGE_ROOT, s3 -> any S3 compatible endpoint.
STORAGE_PROVIDER=local
STORAGE_ROOT=storage
STORAGE_PUBLIC_URL=http://localhost:4000/files
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=dubflow
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- AI providers ----------------------------------------------------------
# AI_MODE=mock  uses deterministic local providers that still produce real
# audio/video artifacts through FFmpeg, so the whole pipeline runs offline.
# AI_MODE=live  uses the providers configured below.
AI_MODE=mock
STT_PROVIDER=mock
TRANSLATION_PROVIDER=mock
TTS_PROVIDER=mock
DIARIZATION_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_STT_MODEL=whisper-1
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2

ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

ASSEMBLYAI_API_KEY=
ASSEMBLYAI_API_URL=https://api.assemblyai.com/v2

# --- Media processing ------------------------------------------------------
# Leave FFMPEG_PATH empty to use the bundled ffmpeg-static binary first and any
# system ffmpeg found on PATH as a fallback.
FFMPEG_PATH=
FFPROBE_PATH=
MAX_UPLOAD_MB=2048
TEMP_WORK_DIR=.work

# --- Frontend (browser safe) ----------------------------------------------
VITE_API_BASE_URL=http://localhost:4000
VITE_APP_NAME=DubFlow
VITE_APP_TAGLINE=Turn any video into a natural Spanish-dubbed experience.

# --- Seed / demo data ------------------------------------------------------
SEED_DEMO_DATA=true
DEMO_USER_EMAIL=demo@dubflow.app
DEMO_USER_PASSWORD=DemoPass123
