# Application
NODE_ENV=development
APP_NAME=autodubflow

# Postgres / Prisma
DATABASE_URL=postgresql://autodubflow:autodubflow@localhost:5432/autodubflow

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Object storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=autodubflow
S3_REGION=us-east-1

# Auth
JWT_SECRET=local-development-jwt-secret-change-before-production
NEXTAUTH_SECRET=local-development-nextauth-secret-change-before-production
NEXTAUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-please-use-32-plus-characters
BETTER_AUTH_URL=http://localhost:4000

# AI / providers
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Browser agent
BROWSER_AGENT_URL=http://localhost:3001
PLAYWRIGHT_BROWSERS_PATH=0

# DubFlow media studio
APP_ENV=development
PORT=4100
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4100
STORAGE_PROVIDER=local
STORAGE_ROOT=storage
AI_MODE=mock
STT_PROVIDER=mock
TRANSLATION_PROVIDER=mock
TTS_PROVIDER=mock
DIARIZATION_PROVIDER=mock
MAX_UPLOAD_MB=2048
TEMP_WORK_DIR=.work

# Internal services
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
WORKER_URL=http://localhost:4001

# Feature flags
ENABLE_ANALYTICS=false
ENABLE_BETA_FEATURES=false
